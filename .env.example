ENZO_TASK_MANAGER=plane
ENZO_DATA_DIR=var/plane
ENZO_HOST=127.0.0.1
ENZO_PORT=8000
ENZO_REVIEWERS=<plane-user-uuid>
# V0 local review surface identity. It must also appear in ENZO_REVIEWERS.
# Replace this with authenticated identity mapping before exposing Enzo publicly.
# ENZO_REVIEW_UI_ACTOR_ID=<plane-user-uuid>
# Plane mode is read-only and has no HTTP worker control unless explicitly
# enabled. Use these only on a trusted development host; they are not auth.
ENZO_REVIEW_UI_WRITE_ENABLED=false
ENZO_ADMIN_API_ENABLED=false

# Agent routing. "fake" is always registered; Pi is registered when enabled.
# Select adapters per workload, with optional role-level fallbacks.
ENZO_AGENT_DEFAULT_RUNNER=fake
# ENZO_AGENT_RUNNER_ARTIFACT_GENERATION=fake
# ENZO_AGENT_RUNNER_ARTIFACT_REVISION=fake
# ENZO_AGENT_RUNNER_IMPLEMENTATION=fake
# ENZO_AGENT_RUNNER_IMPLEMENTATION_REVISION=fake
# ENZO_AGENT_RUNNER_ROLE_INTENT=fake

# Pi RPC adapter. Enable it before selecting "pi" in a route. Enzo passes only
# base process variables plus names explicitly listed in ENZO_PI_ENV_ALLOWLIST.
# Install: npm install -g --ignore-scripts @earendil-works/pi-coding-agent
ENZO_PI_ENABLED=false
ENZO_PI_COMMAND=pi
ENZO_PI_TIMEOUT_SECONDS=900
# ENZO_PI_MAX_TRANSCRIPT_BYTES=10485760
# ENZO_PI_PROVIDER=deepseek
# ENZO_PI_MODEL=deepseek-v4-pro
# ENZO_PI_ENV_ALLOWLIST=DEEPSEEK_API_KEY
# Shell tools are intentionally forbidden; Enzo owns commands and Git.
ENZO_PI_IMPLEMENTATION_TOOLS=read,write,edit,grep,find,ls

ENZO_PLANE_BASE_URL=http://localhost:18080
ENZO_PLANE_API_TOKEN=<plane-api-token>
ENZO_PLANE_WEBHOOK_SECRET=<shared-webhook-secret>
ENZO_PLANE_WORKSPACE_SLUG=<workspace-slug>
ENZO_PLANE_PROJECT_ID=<plane-project-uuid>
ENZO_PLANE_MANAGED_LABEL=enzo:managed
ENZO_PLANE_STAGE_STATE_IDS={}

ENZO_ARTIFACT_BASE_URL=http://localhost:8000

# Project-level repository binding. Leave ENZO_REPOSITORY_URL unset to keep
# implementation jobs parked at the safe PREPARE_IMPLEMENTATION boundary.
ENZO_PROJECT_NAME=Enzo Test Project
# ENZO_REPOSITORY_URL=git@host:org/monorepo.git
ENZO_REPOSITORY_DEFAULT_BRANCH=main
ENZO_GIT_BRANCH_PREFIX=ai/
ENZO_GIT_AUTO_PUSH=true
ENZO_CLEANUP_ON_DONE=true
# ENZO_COMMAND_BOOTSTRAP=pnpm install
# Execution-enabled projects must configure all three deterministic checks.
# ENZO_COMMAND_LINT=pnpm lint
# ENZO_COMMAND_TEST=pnpm test
# ENZO_COMMAND_BUILD=pnpm build
